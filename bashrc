# ==============================================================================
# PROMPT (PS1): [<exit-code>] <user>:<relative-dir> (git:<branch>) $/#
# ==============================================================================

__git_branch() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
    if [ -n "$branch" ]; then
        printf "(git:%s)" "$branch"
    fi
}

__git_state_color() {
    local c_green='\[\e[1;32m\]'
    local c_red='\[\e[1;31m\]'
    local c_yellow='\[\e[1;33m\]'
    local c_magenta='\[\e[1;35m\]'

    # Verify we are inside a Git work tree
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        return 1
    fi

    # 1. Unstaged changes in tracked files (ignores untracked files)
    if ! git diff --quiet 2>/dev/null; then
        printf "%s" "$c_red"
        return 0
    fi

    # 2. Staged changes not yet committed
    if ! git diff --cached --quiet 2>/dev/null; then
        printf "%s" "$c_yellow"
        return 0
    fi

    # 3. Unpushed local commits compared to upstream/origin HEAD
    local upstream ahead
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
    if [ -z "$upstream" ] && git rev-parse --verify --quiet "origin/HEAD" >/dev/null 2>&1; then
        upstream="origin/HEAD"
    fi
    if [ -n "$upstream" ]; then
        ahead=$(git rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)
        if [ "$ahead" -gt 0 ]; then
            printf "%s" "$c_magenta"
            return 0
        fi
    fi

    # 4. Clean working tree and staged index
    printf "%s" "$c_green"
}

__set_prompt() {
    local exit_code=$?
    local c_reset='\[\e[0m\]'
    local c_green='\[\e[1;32m\]'
    local c_red='\[\e[1;31m\]'
    local c_blue='\[\e[1;34m\]'
    local c_bold_white='\[\e[1;37m\]'
    local c_exit
    local c_user
    local c_prompt_char
    local prompt_char
    local git_info
    local c_git
    local git_segment=""

    if [ "$exit_code" -eq 0 ]; then
        c_exit=$c_green
    else
        c_exit=$c_red
    fi

    if [ "$EUID" -eq 0 ]; then
        c_user=$c_red
        c_prompt_char=$c_red
        prompt_char="#"
    else
        c_user=$c_bold_white
        c_prompt_char=$c_green
        prompt_char="$"
    fi

    git_info=$(__git_branch)
    if [ -n "$git_info" ]; then
        c_git=$(__git_state_color)
        git_segment=" ${c_git}${git_info}${c_reset}"
    fi

    PS1="[${c_exit}${exit_code}${c_reset}] ${c_user}\u${c_reset}:${c_blue}\W${c_reset}${git_segment} ${c_prompt_char}${prompt_char}${c_reset} "
}

PROMPT_COMMAND=__set_prompt

